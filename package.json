{
  "name": "toolwall",
  "version": "0.0.0",
  "description": "Local-first MCP guardrail proxy. Continuously re-verifies tool definitions before every call to catch rug pulls. No account, no telemetry, no network calls.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "proxy",
    "prompt-injection",
    "tool-poisoning",
    "rug-pull",
    "guardrail",
    "ai-security"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "toolwall": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:attacks": "vitest run test/attacks",
    "bench": "npm run build && node bench/latency.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "agent-threat-rules": "^3.5.12"
  }
}
